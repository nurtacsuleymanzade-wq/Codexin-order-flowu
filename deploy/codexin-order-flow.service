[Unit]
Description=Codexin Order Flow production backend
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Codexin-order-flowu
Environment=PYTHONPATH=/root/Codexin-order-flowu/backend
Environment=CODEXIN_SYMBOL=BTCUSDT
Environment=CODEXIN_CORS_ORIGINS=https://nurtacsuleymanzade-wq.github.io,http://localhost:4173
Environment=CODEXIN_RAW_DIR=/var/lib/codexin-order-flow/raw-events
Environment=CODEXIN_REDIS_URL=redis://127.0.0.1:6379/1
ExecStart=/root/.agent-reach-venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8020 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
